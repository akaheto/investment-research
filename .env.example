# Copy to .env and fill in. .env is gitignored — never commit real values.

# FRED (Federal Reserve Economic Data) — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Sharadar (Nasdaq Data Link) — fundamentals/prices connector
SHARADAR_API_KEY=

# Claude API — needed from Epic G5 (event-overlay assessments)
# ANTHROPIC_API_KEY=

# Turso (only when deploying to Vercel; local dev uses file:local.db)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Secret guarding /api/refresh when deployed (Vercel cron)
# CRON_SECRET=

# Interactive Brokers — read-only positions/balances via Fly.io-hosted Client Portal Gateway
# IBKR_GATEWAY_URL= (e.g. https://my-app.fly.dev/gateway)
# IBKR_GATEWAY_SECRET= (shared secret with Fly.io instance)
# BROKERAGE_PROVIDER=ibkr
